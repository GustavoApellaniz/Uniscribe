# Copie para .env apenas no servidor. Nunca inclua este arquivo com valores reais.
GEMINI_API_KEY=
# stub (padrão) ou whisper-local após instalar openai-whisper/ffmpeg
UNISCRIBE_TRANSCRIBER=stub
UNISCRIBE_HOST=127.0.0.1
UNISCRIBE_PORT=8080
UNISCRIBE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UNISCRIBE_REQUEST_TIMEOUT=30
UNISCRIBE_MAX_WORKERS=8
# Obrigatório quando o backend escuta fora de localhost:
UNISCRIBE_AUTH_TOKEN=
UNISCRIBE_LOG_LEVEL=INFO
